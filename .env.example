# Copy to .env and fill in. Never commit .env.

# --- LLM: free now (OpenRouter), paid later (change LLM_PROVIDER + key only) ---
# openrouter | openai | gemini | ollama
LLM_PROVIDER=openrouter
# Free key from openrouter.ai/keys
OPENROUTER_API_KEY=
# A model id ending in :free, picked from openrouter.ai/models
LLM_MODEL=
# 1-2 more :free ids, comma-separated
LLM_FALLBACK_MODELS=
# Later, when you have a paid key
OPENAI_API_KEY=
# Later, optional
GOOGLE_API_KEY=
# Local development with LLM_PROVIDER=ollama: no key, no request limit. Set LLM_MODEL to a
# model you have pulled (`ollama pull <model>`, then `ollama list`).
# From inside docker compose the host's Ollama is at http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings: free and local by default ---
# local | openai
EMBEDDING_PROVIDER=local

# --- Request budget for free models ---
LLM_MAX_RPM=15
LLM_CACHE=true

# --- SEC EDGAR asks for a descriptive User-Agent with a contact email ---
SEC_USER_AGENT=Your Name your-email@example.com

# --- API and UI ---
# /ask requests allowed per client IP per minute
API_RATE_LIMIT_PER_MINUTE=20
# Questions answered at the same time, over all clients; more get a 503 "busy"
API_MAX_CONCURRENT=4
# Origins allowed to call the API from a browser, comma-separated
CORS_ORIGINS=http://localhost:8501
# Where the Streamlit UI finds the API (docker compose sets it to http://api:8000)
API_URL=http://localhost:8000
# How long the UI waits for an answer, in seconds; use 300 with a local Ollama model
# (docker compose sets 300)
UI_TIMEOUT_SECONDS=120

# --- Database ---
# Host port that docker compose publishes Postgres on. 5433 avoids a local Postgres on 5432.
DB_PORT=5433
DATABASE_URL=postgresql+psycopg://finquery:finquery@localhost:5433/finquery
READER_DATABASE_URL=postgresql+psycopg://agent_reader:reader_pw@localhost:5433/finquery
